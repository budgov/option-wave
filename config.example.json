{
  "timezone": "America/Los_Angeles",
  "keepAwake": true,
  "channels": [
    {
      "key": "meigu_baijialun",
      "title": "美股百家论"
    },
    {
      "key": "go_finance",
      "title": "Go Finance"
    }
  ],
  "channelSemantics": {
    "meigu_baijialun": { "entryAction": "buy_to_open", "exitAction": "sell_to_close", "entryAtPriceMeaning": "source_reported_fill", "missingExpiryPolicy": "nearest_listed_expiry", "profitControlPolicy": "half_remaining_each_signal", "rule": "Each 盈利自控 closes 50% of the then-remaining position; exit percentages apply to the then-remaining position; final-close language closes all remaining exposure." },
    "go_finance": { "entryAction": "buy_to_open", "exitAction": "sell_to_close", "entryAtPriceMeaning": "source_reported_fill", "missingExpiryPolicy": "nearest_listed_expiry", "profitControlPolicy": "half_remaining_each_signal", "rule": "Long-form option research and sell-put/SP strategy prose are secondary context. Each 盈利自控 closes 50% of the then-remaining position; final-close language closes all remaining exposure." }
  },
  "listener": {
    "pollIntervalSeconds": 10,
    "heartbeatSeconds": 10,
    "retryIntervalSeconds": 60,
    "batchSize": 100,
    "retryBatchSize": 2,
    "maxQueuedMessages": 250,
    "maxConsecutivePollErrors": 3,
    "analysisAlertAfterAttempts": 2,
    "humanInterpretationConfidenceThreshold": 0.75,
    "humanInterpretationDefaultSymbol": "SPY"
  },
  "positionWorkflow": {
    "enabled": true,
    "maxActive": 16,
    "workerStartupTimeoutSeconds": 5,
    "workerRequestTimeoutSeconds": 15,
    "workerShutdownTimeoutSeconds": 5,
    "completionRetrySeconds": 60,
    "orphanMaxHoldHours": 720,
    "feedbackLearningRate": 0.025,
    "feedbackMinimumSamples": 30,
    "marketCloseLocalTime": "13:00"
  },
  "intradayResearch": {
    "enabled": true,
    "symbols": ["QQQ", "SPY"],
    "contextSymbols": ["IWM", "DIA", "TLT", "GLD"],
    "sampleIntervalSeconds": 60,
    "forecastIntervalMinutes": 30,
    "forecastHorizonMinutes": 30,
    "marketTimeZone": "America/New_York",
    "fallbackOpenLocalTime": "09:30",
    "fallbackCloseLocalTime": "16:00",
    "maximumQuoteAgeSeconds": 15,
    "maximumQuoteSkewMilliseconds": 3000,
    "maximumScoreAlignmentSeconds": 5,
    "maximumCatchupSlotsPerAdvance": 2,
    "maximumActiveChannelWorkers": 8,
    "fourierWindowMinutes": 120,
    "minimumFourierSamples": 32,
    "minimumActionableProbabilityEdge": 0.02,
    "minimumActionableExpectedReturnBps": 3,
    "minimumPromotionTradingDays": 40,
    "minimumPromotionForecasts": 500,
    "stateDir": "data/intraday-state"
  },
  "media": {
    "enabled": true,
    "visionModel": "openai/gpt-5.6-luna",
    "maxDimension": 4096,
    "minShortEdge": 384,
    "maxBytes": 20971520,
    "timeoutSeconds": 180
  },
  "notifications": {
    "telegram": {
      "enabled": false,
      "minIntervalMs": 0,
      "timeoutMs": 20000
    }
  },
  "data": {
    "database": "data/ocean-wave.sqlite"
  },
  "openclaw": {
    "binary": "openclaw",
    "timeoutSeconds": 600,
    "maxOutputBytes": 8388608,
    "transientAttempts": 2,
    "transientRetryDelayMs": 2000,
    "agents": {
      "luna": {
        "id": "ocean-luna",
        "model": "openai/gpt-5.6-luna",
        "thinking": "medium"
      },
      "terra": {
        "id": "ocean-terra",
        "model": "openai/gpt-5.6-terra",
        "thinking": "high"
      },
      "sol": {
        "id": "ocean-sol",
        "model": "openai/gpt-5.6-sol",
        "thinking": "high"
      }
    }
  },
  "marketData": {
    "primary": "schwab",
    "crossCheck": ["fidelity_web"],
    "fallback": ["fidelity_web"],
    "python": ".venv/Scripts/python.exe",
    "script": "scripts/schwab_predict.py",
    "workerScript": "scripts/realtime_worker.py",
    "requireNativeCore": true,
    "workerMaxSymbols": 32,
    "workerMaxRequests": 100,
    "workerStartupTimeoutSeconds": 15,
    "workerShutdownTimeoutSeconds": 15,
    "stateDir": "data/ocean-wave-state",
    "maxLiveLagSeconds": 30,
    "crossCheckWaitMilliseconds": 1000,
    "horizonsMinutes": "5,15,30,60",
    "strikeCount": 40,
    "timeoutSeconds": 30,
    "maxProcessOutputBytes": 4194304,
    "fidelity": {
      "timeoutSeconds": 4
    },
    "validation": {
      "maxUnderlyingDifferenceBps": 25,
      "maxCrossCheckTimeSkewSeconds": 15
    }
  },
  "safety": {
    "readOnly": true,
    "allowOutboundTelegram": false,
    "allowTrading": false
  }
}
